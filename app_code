    def stat(self, parent, title):

        f = tk.Frame(
            parent,
            bg=self.PANEL,
            padx=20,
            pady=5
        )
        f.pack(side="left", fill="x", expand=True, padx=3)

        tk.Label(
            f,
            text=title,
            fg=self.MUTED,
            bg=self.PANEL,
            font=("Arial", 8, "bold")
        ).pack()

        label = tk.Label(
            f,
            text="0",
            fg=self.WHITE,
            bg=self.PANEL,
            font=("Arial", 15, "bold")
        )
        label.pack()

        return label

    def button(self, parent, text, command, color):

        return tk.Button(
            parent,
            text=text,
            command=command,
            bg=color,
            fg="white",
            activebackground=color,
            activeforeground="white",
            relief="flat",
            font=("Arial", 10, "bold"),
            padx=18,
            pady=8
