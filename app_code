import tkinter as tk
from tkinter import messagebox
import random, ipaddress

class App:
    BG="#0f172a"; PANEL="#1e293b"; INPUT="#263449"
    WHITE="#f8fafc"; MUTED="#94a3b8"; BLUE="#3b82f6"
    GREEN="#22c55e"; RED="#ef4444"; YELLOW="#f59e0b"; CYAN="#06b6d4"

    def __init__(self, root):
        self.r=root; root.title("CCNA Subnetting Practice")
        root.geometry("1100x800"); root.minsize(850,650); root.configure(bg=self.BG)
        self.mode=tk.StringVar(value="Subnetting"); self.diff=tk.StringVar(value="Medium")
        self.qnum=0; self.qcount=10; self.score=0; self.possible=0
        self.streak=0; self.best=0; self.q=None; self.inputs=[]; self.vinputs=[]
        self.answered=False; self.timer=None; self.time=0
        self.build(); self.new()

    def label(self,p,text,size=10,color=None,bold=False):
        return tk.Label(p,text=text,font=("Arial",size,"bold" if bold else "normal"),
                        fg=color or self.WHITE,bg=p["bg"])

    def build(self):
        h=tk.Frame(self.r,bg=self.BG); h.pack(fill="x",padx=25,pady=15)
        self.label(h,"CCNA SUBNETTING PRACTICE",26,bold=True).pack(side="left")
        self.timerlabel=self.label(h,"∞",20,self.CYAN,True); self.timerlabel.pack(side="right")

        s=tk.Frame(self.r,bg=self.PANEL,padx=10,pady=10); s.pack(fill="x",padx=25,pady=5)
        self.menu(s,"Mode",self.mode,["Subnetting","VLSM","Binary"],self.restart)
        self.menu(s,"Difficulty",self.diff,["Easy","Medium","Hard","Expert"],self.new)
        self.menu(s,"Questions",None,["5","10","20","30","50"],self.restart)
        self.qvar=s.winfo_children()[-1]
        tk.Checkbutton(s,text="Timed",variable=tk.BooleanVar(),command=self.new,
                       fg=self.WHITE,bg=self.PANEL,selectcolor="#334155").pack(side="left",padx=15)

        st=tk.Frame(self.r,bg=self.BG); st.pack(fill="x",padx=25)
        self.qstat=self.stat(st,"QUESTION"); self.sstat=self.stat(st,"SCORE")
        self.tstat=self.stat(st,"STREAK"); self.astat=self.stat(st,"ACCURACY")

        p=tk.Frame(self.r,bg=self.PANEL,padx=15,pady=12); p.pack(fill="x",padx=25,pady=8)
        self.typ=self.label(p,"",10,self.MUTED,True); self.typ.pack()
        self.qlabel=self.label(p,"",24,self.CYAN,True); self.qlabel.pack(pady=4)
        self.inst=self.label(p,"",10,self.MUTED); self.inst.pack()

        self.area=tk.Frame(self.r,bg=self.BG); self.area.pack(fill="both",expand=True,padx=25)

        b=tk.Frame(self.r,bg=self.BG); b.pack(pady=8)
        for text,cmd,col in [("SUBMIT",self.check,self.BLUE),("HINT",self.hint,self.YELLOW),
                             ("SOLUTION",self.solution,"#334155"),("NEXT",self.new,self.GREEN),
                             ("END",self.end,self.RED)]:
            tk.Button(b,text=text,command=cmd,bg=col,fg="white",relief="flat",
                      font=("Arial",10,"bold"),padx=16,pady=7).pack(side="left",padx=3)

        self.status=self.label(self.r,"",10,self.MUTED); self.status.pack(pady=5)

    def menu(self,p,text,var,vals,cmd):
        self.label(p,text,10,bold=True).pack(side="left",padx=(8,3))
        if var is None:
            var=tk.StringVar(value=vals[1] if len(vals)>1 else vals[0])
        m=tk.OptionMenu(p,var,*vals,command=lambda _:cmd())
        m.config(bg="#334155",fg=self.WHITE,activebackground=self.BLUE,
                 activeforeground="white",highlightthickness=0)
        m["menu"].config(bg="#334155",fg=self.WHITE); m.pack(side="left",padx=5)
        if text=="Questions": self.qvar=var

    def stat(self,p,title):
        f=tk.Frame(p,bg=self.PANEL,padx=15,pady=4); f.pack(side="left",fill="x",expand=True,padx=2)
        self.label(f,title,8,self.MUTED,True).pack()
        x=self.label(f,"0",14,bold=True); x.pack(); return x

    def clear(self):
        if self.timer: self.r.after_cancel(self.timer); self.timer=None
        for w in self.area.winfo_children(): w.destroy()
        self.inputs=[]; self.vinputs=[]; self.answered=False

    def restart(self):
        self.qnum=self.score=self.possible=self.streak=self.best=0
        self.new()

    def new(self):
        self.clear(); self.qcount=int(self.qvar.get())
        if self.qnum>=self.qcount:
            if self.qnum: return self.finish()
        self.qnum+=1
        {"Subnetting":self.subnet,"VLSM":self.vlsm,"Binary":self.binary}[self.mode.get()]()
        self.stats(); self.start_timer()

    # ---------------- SUBNETTING ----------------

    def subnet(self):
        lo={"Easy":24,"Medium":16,"Hard":8,"Expert":1}[self.diff.get()]
        c=random.randint(lo,30); ip=ipaddress.IPv4Address(random.randint(1,0xfffffffe))
        n=ipaddress.ip_network(f"{ip}/{c}",strict=False); x=int(str(ip).split(".")[0])
        cls="A" if x<=126 else "B" if x<=191 else "C" if x<=223 else "D" if x<=239 else "E"
        default={"A":8,"B":16,"C":24}.get(cls)
        subs=2**(c-default) if default and c>=default else "N/A"
        bigger=random.randint(c+1,30) if c<30 else 31

        self.q={"answers":[str(n.netmask),str(n.hostmask),cls,str(n.network_address),
            str(n.network_address+1),str(n.broadcast_address-1),str(n.broadcast_address),
            str(max(0,n.num_addresses-2)),str(subs),f"/{bigger}",str(2**(bigger-c))],"cidr":c}

        self.typ.config(text="STANDARD IPv4 SUBNETTING"); self.qlabel.config(text=f"{ip} /{c}")
        self.inst.config(text="Calculate every field below.")
        labs=["Subnet mask","Wildcard mask","Class","Network","First usable","Last usable",
              "Broadcast","Usable hosts","Number of subnets","Larger CIDR","Subnets that fit"]
        self.fields(labs)

    # ---------------- VLSM ----------------

    def vlsm(self):
        sets={
            "Easy":((24,3),[4,6,10,12,20,25]),
            "Medium":((23,4),[6,10,12,20,25,30,50]),
            "Hard":((22,5),[10,12,20,25,30,50,60,100]),
            "Expert":((20,6),[20,25,30,50,60,100,120,200])
        }
        (prefix,count),choices=sets[self.diff.get()]
        while True:
            hosts=sorted(random.sample(choices,count),reverse=True)
            blocks=[2**((h+2-1).bit_length()) for h in hosts]
            if sum(blocks)<=2**(32-prefix): break

        base=ipaddress.ip_network(f"{random.randint(1,223)}.0.0.0/{prefix}",strict=False)
        cur=int(base.network_address); ans=[]
        for h,b in zip(hosts,blocks):
            p=32-(b.bit_length()-1); n=ipaddress.ip_network((cur,p))
            ans.append([f"/{p}",str(n.netmask),str(n.network_address),
                        str(n.network_address+1),str(n.broadcast_address-1),str(n.broadcast_address)])
            cur+=b

        self.q={"base":str(base),"hosts":hosts,"answers":ans}
        self.typ.config(text="VLSM — VARIABLE LENGTH SUBNET MASKING")
        self.qlabel.config(text=str(base))
        self.inst.config(text=f"Host requirements: {hosts}")

        frame=tk.Frame(self.area,bg=self.BG); frame.pack(fill="x",expand=True)
        heads=["#","Hosts","CIDR","Mask","Network","First","Last","Broadcast"]
        widths=[4,7,8,15,15,15,15,15]
        for c,(h,w) in enumerate(zip(heads,widths)):
            self.label(frame,h,8,self.CYAN,True).grid(row=0,column=c,padx=1,pady=2)

        for r,(h,a) in enumerate(zip(hosts,ans),1):
            self.label(frame,str(r),8).grid(row=r,column=0)
            self.label(frame,str(h),8,self.YELLOW).grid(row=r,column=1)
            row=[]
            for c,v in enumerate(a,2):
                e=tk.Entry(frame,width=widths[c],bg=self.INPUT,fg=self.WHITE,
                           insertbackground="white",relief="flat",font=("Arial",8))
                e.grid(row=r,column=c,padx=1,pady=2,ipady=2); row.append(e)
            self.vinputs.append(row)

    # ---------------- BINARY ----------------

    def binary(self):
        c=random.randint(1,30); m=ipaddress.IPv4Network(f"0.0.0.0/{c}").netmask
        b=".".join(f"{int(x):08b}" for x in str(m).split("."))
        typ=random.choice([0,1,2])
        if typ==0: q,a=str(m),b; text=q; inst="Convert the mask to binary."
        elif typ==1: q,a=f"/{c}",str(m); text=q; inst="Convert CIDR to dotted decimal."
        else: q,a=b,str(m); text=q; inst="Convert binary to a subnet mask."
        self.q={"answers":[a]}; self.typ.config(text="BINARY PRACTICE")
        self.qlabel.config(text=text); self.inst.config(text=inst); self.fields(["Answer"])

    def fields(self,labs):
        for x in labs:
            f=tk.Frame(self.area,bg=self.BG); f.pack(pady=2)
            self.label(f,x,9).pack(side="left",padx=6)
            e=tk.Entry(f,width=30,bg=self.INPUT,fg=self.WHITE,insertbackground="white",relief="flat")
            e.pack(side="left",ipady=3); self.inputs.append(e)

    # ---------------- CHECK ----------------

    def check(self):
        if self.answered:return
        self.answered=True
        if self.mode.get()=="VLSM":
            got=sum(e.get().strip().upper()==a.upper() for row,aa in zip(self.vinputs,self.q["answers"]) for e,a in zip(row,aa))
            possible=len(self.q["answers"])*6
        else:
            got=sum(e.get().strip().upper()==a.upper() for e,a in zip(self.inputs,self.q["answers"]))
            possible=len(self.inputs)

        self.score+=got; self.possible+=possible
        self.streak=self.streak+1 if got==possible else 0
        self.best=max(self.best,self.streak)
        for e,a in [(e,a) for row,aa in zip(self.vinputs,self.q.get("answers",[])) for e,a in zip(row,aa)] if self.mode.get()=="VLSM" else zip(self.inputs,self.q["answers"]):
            e.config(bg="#14532d" if e.get().strip().upper()==a.upper() else "#7f1d1d")
        self.stats(); self.status.config(text=f"{got}/{possible} correct")
        if self.qnum>=self.qcount:self.r.after(300,self.finish)

    # ---------------- HINT / SOLUTION ----------------

    def hint(self):
        if self.mode.get()=="VLSM":
            s="Sort hosts largest → smallest.\nAdd 2 for network/broadcast.\nRound up to a power of 2."
        elif self.mode.get()=="Binary":
            s="A /N mask has N ones followed by 32-N zeros."
        else:
            s=f"/{self.q['cidr']} means {32-self.q['cidr']} host bits.\nUsable hosts = 2^host bits - 2."
        messagebox.showinfo("Hint",s)

    def solution(self):
        if self.mode.get()=="VLSM":
            t=f"BASE: {self.q['base']}\n\n"
            for i,(h,a) in enumerate(zip(self.q["hosts"],self.q["answers"]),1):
                t+=f"Subnet {i} ({h} hosts)\nCIDR: {a[0]}\nMask: {a[1]}\nNetwork: {a[2]}\nFirst: {a[3]}\nLast: {a[4]}\nBroadcast: {a[5]}\n\n"
        else:
            t="\n".join(f"{x}: {y}" for x,y in zip(
                ["Subnet mask","Wildcard mask","Class","Network","First usable","Last usable",
                 "Broadcast","Usable hosts","Subnets","Larger CIDR","Subnets that fit"],
                self.q["answers"]))
        w=tk.Toplevel(self.r); w.title("Solution"); w.geometry("600x600")
        tbox=tk.Text(w,bg=self.PANEL,fg=self.WHITE,font=("Courier New",10))
        tbox.pack(fill="both",expand=True,padx=10,pady=10); tbox.insert("1.0",t); tbox.config(state="disabled")

    # ---------------- TIMER / STATS ----------------

    def start_timer(self):
        if self.timer: self.r.after_cancel(self.timer); self.timer=None
        self.timerlabel.config(text="∞",fg=self.CYAN)

    def stats(self):
        acc=self.score/self.possible*100 if self.possible else 0
        self.qstat.config(text=f"{self.qnum}/{self.qcount}")
        self.sstat.config(text=f"{self.score}/{self.possible}")
        self.tstat.config(text=str(self.streak))
        self.astat.config(text=f"{acc:.0f}%")

    def end(self):
        self.finish()

    def finish(self):
        acc=self.score/self.possible*100 if self.possible else 0
        messagebox.showinfo("Quiz Complete",
            f"Questions: {self.qnum}\nScore: {self.score}/{self.possible}\n"
            f"Accuracy: {acc:.1f}%\nBest streak: {self.best}")
        self.restart()

root=tk.Tk()
App(root)
root.mainloop()
