    # ========================================================
    # Question control
    # ========================================================

    def clear(self):

        if self.timer_id:
            self.root.after_cancel(self.timer_id)
            self.timer_id = None

        for w in self.answer_container.winfo_children():
            w.destroy()

        self.inputs = []
        self.vlsm_inputs = []
        self.answered = False

    def change_mode(self):
        self.restart_quiz()

    def restart_quiz(self):

        self.question_no = 0
        self.score = 0
        self.possible = 0
        self.streak = 0
        self.best_streak = 0
        self.new_question()

    def new_question(self):

        self.clear()

        self.question_count = int(
            self.questions_var.get()
        )

        if self.question_no >= self.question_count:
            if self.question_no:
                self.finish_quiz()
                return

        self.question_no += 1

        if self.mode.get() == "Subnetting":
            self.make_subnet_question()

        elif self.mode.get() == "VLSM":
            self.make_vlsm_question()

        else:
            self.make_binary_question()

        self.update_stats()
        self.start_timer()

    # ========================================================
    # Standard subnetting
    # ========================================================

    def make_subnet_question(self):

        ranges = {
            "Easy": (24, 30),
            "Medium": (16, 30),
            "Hard": (8, 30),
            "Expert": (1, 30)
        }

        cidr = random.randint(
            *ranges[self.difficulty.get()]
        )

        ip = ipaddress.IPv4Address(
            random.randint(1, 0xFFFFFFFE)
        )

        network = ipaddress.ip_network(
            f"{ip}/{cidr}",
            strict=False
        )

        first_octet = int(str(ip).split(".")[0])

        if first_octet <= 126:
            address_class = "A"
            default_prefix = 8
        elif first_octet <= 191:
            address_class = "B"
            default_prefix = 16
        elif first_octet <= 223:
            address_class = "C"
            default_prefix = 24
        elif first_octet <= 239:
            address_class = "D"
            default_prefix = None
        else:
            address_class = "E"
            default_prefix = None

        if default_prefix and cidr >= default_prefix:
            subnet_count = 2 ** (cidr - default_prefix)
        else:
            subnet_count = "N/A"

        usable = (
            network.num_addresses - 2
            if cidr <= 30 else
            network.num_addresses
        )

        bigger = random.randint(
            cidr + 1, 30
        ) if cidr < 30 else 31

        self.question = {
            "ip": str(ip),
            "cidr": cidr,
            "network": network,
            "answers": [
                str(network.netmask),
                str(network.hostmask),
                address_class,
                str(network.network_address),
                str(network.network_address + 1),
                str(network.broadcast_address - 1),
                str(network.broadcast_address),
                str(usable),
                str(subnet_count),
                f"/{bigger}",
                str(2 ** (bigger - cidr))
            ]
        }

        self.type_label.config(
            text="STANDARD IPv4 SUBNETTING"
        )

        self.question_label.config(
            text=f"{ip} /{cidr}"
        )

        self.instruction.config(
            text="Calculate every field below."
        )

        labels = [
            "Subnet mask",
            "Wildcard mask",
            "Address class",
            "Network address",
            "First usable IP",
            "Last usable IP",
            "Broadcast address",
            "Usable hosts",
            "Number of subnets",
            "Choose a larger CIDR",
            "Smaller subnets created"
        ]

        for label, answer in zip(
            labels,
            self.question["answers"]
        ):
            self.add_input(label)

    # ========================================================
    # VLSM
    # ========================================================

   def vlsm(self):
    diff = {
        "Easy":   ((24, 3), [4, 6, 10, 12, 20, 25]),
        "Medium": ((23, 4), [6, 10, 12, 20, 25, 30, 50]),
        "Hard":   ((22, 5), [10, 12, 20, 25, 30, 50, 60, 100]),
        "Expert": ((20, 6), [20, 25, 30, 50, 60, 100, 120, 200])
    }[self.diff.get()]

    prefix, count = diff[0]
    choices = diff[1]

    while True:
        hosts = sorted(random.sample(choices, count), reverse=True)
        blocks = [2 ** ((h + 2 - 1).bit_length()) for h in hosts]

        if sum(blocks) <= 2 ** (32 - prefix):
            break

    base = ipaddress.ip_network(
        f"{random.randint(1, 223)}.0.0.0/{prefix}",
        strict=False
    )

    current = int(base.network_address)

    self.data = {
        "base": base,
        "answers": []
    }

    self.question.config(text=f"VLSM: {base}")
    self.instruction_label.config(
        text=f"Hosts required: {', '.join(map(str, hosts))}"
    )

    # VLSM table
    table = tk.Frame(self.area, bg="#111827")
    table.pack(fill="x", padx=5)

    headers = [
        "Subnet", "Hosts", "CIDR", "Mask",
        "Network", "First", "Last", "Broadcast"
    ]

    widths = [7, 8, 9, 16, 16, 16, 16, 16]

    for c, (header, width) in enumerate(zip(headers, widths)):
        tk.Label(
            table,
            text=header,
            width=width,
            fg="#06b6d4",
            bg="#111827",
            font=("Arial", 8, "bold")
        ).grid(row=0, column=c, padx=1, pady=3)

    self.boxes = []

    for r, (needed, block) in enumerate(zip(hosts, blocks), 1):
        p = 32 - (block.bit_length() - 1)
        n = ipaddress.ip_network((current, p))

        tk.Label(
            table,
            text=str(r),
            width=7,
            fg="white",
            bg="#111827"
        ).grid(row=r, column=0)

        tk.Label(
            table,
            text=str(needed),
            width=8,
            fg="#f59e0b",
            bg="#111827"
        ).grid(row=r, column=1)

        values = [
            f"/{p}",
            str(n.netmask),
            str(n.network_address),
            str(n.network_address + 1),
            str(n.broadcast_address - 1),
            str(n.broadcast_address)
        ]

        row = []

        for c, value in enumerate(values, 2):
            e = tk.Entry(
                table,
                width=widths[c],
                bg="#263244",
                fg="white",
                insertbackground="white",
                relief="flat",
                font=("Arial", 8)
            )
            e.grid(row=r, column=c, padx=1, pady=2, ipady=2)
            row.append(e)

        self.boxes.append(row)
        self.data["answers"].append(values)

        current += block

    # ========================================================
    # Binary questions
    # ========================================================

    def make_binary_question(self):

        cidr = random.randint(1, 30)

        mask = ipaddress.IPv4Network(
            f"0.0.0.0/{cidr}"
        ).netmask

        mask_binary = ".".join(
            f"{int(x):08b}"
            for x in str(mask).split(".")
        )

        question_type = random.choice([
            "mask_to_binary",
            "cidr_to_mask",
            "binary_to_mask"
        ])

        if question_type == "mask_to_binary":

            self.question = {
                "answers": [mask_binary]
            }

            self.question_label.config(
                text=str(mask)
            )

            self.type_label.config(
                text="BINARY MASK PRACTICE"
            )

            self.instruction.config(
                text="Convert this subnet mask to binary."
            )

            self.add_input("Binary mask")

        elif question_type == "cidr_to_mask":

            self.question = {
                "answers": [str(mask)]
            }

            self.question_label.config(
                text=f"/{cidr}"
            )

            self.type_label.config(
                text="CIDR → SUBNET MASK"
            )

            self.instruction.config(
                text="Convert the CIDR prefix to a subnet mask."
            )

            self.add_input("Subnet mask")

        else:

            self.question = {
                "answers": [str(mask)]
            }

            self.question_label.config(
                text=mask_binary
            )

            self.type_label.config(
                text="BINARY → SUBNET MASK"
            )

            self.instruction.config(
                text="Convert the binary mask to dotted decimal."
            )

            self.add_input("Subnet mask")

    # ========================================================
    # Standard input
    # ========================================================

    def add_input(self, label):

        row = tk.Frame(
            self.answer_container,
            bg=self.BG
        )

        row.pack(
            pady=2
        )

        tk.Label(
            row,
            text=label,
            width=25,
            anchor="e",
            fg=self.WHITE,
            bg=self.BG,
            font=("Arial", 9)
        ).pack(
            side="left",
            padx=8
        )

        e = tk.Entry(
            row,
            width=30,
            bg=self.INPUT,
            fg=self.WHITE,
            insertbackground="white",
            relief="flat"
        )

        e.pack(
            side="left",
            ipady=4
        )

        self.inputs.append(e)

    # ========================================================
    # Checking
    # ========================================================

    def check(self):

        if self.answered:
            return

        self.answered = True

        if self.mode.get() == "VLSM":
            correct, possible = self.check_vlsm()
        else:
            correct, possible = self.check_normal()

        self.score += correct
        self.possible += possible

        if correct == possible:
            self.streak += 1
            self.best_streak = max(
                self.best_streak,
                self.streak
            )
        else:
            self.streak = 0

        self.update_stats()

        if correct == possible:
            msg = "Perfect!"
        elif correct >= possible * .75:
            msg = "Good job!"
        elif correct >= possible * .5:
            msg = "Not bad!"
        else:
            msg = "Keep practicing!"

        self.status.config(
            text=f"{msg}   {correct}/{possible} correct."
        )

        if self.question_no >= self.question_count:
            self.root.after(
                300,
                self.finish_quiz
            )

    def check_normal(self):

        correct = 0

        for e, answer in zip(
            self.inputs,
            self.question["answers"]
        ):

            user = e.get().strip()

            if user.upper() == answer.upper():
                correct += 1
                e.config(bg="#14532d")
            else:
                e.config(bg="#7f1d1d")

        return correct, len(self.inputs)

    def check_vlsm(self):

        correct = 0
        possible = len(
            self.question["answers"]
        ) * 6

        for row, answers in zip(
            self.vlsm_inputs,
            self.question["answers"]
        ):

            for e, answer in zip(
                row,
                answers
            ):

                if e.get().strip().upper() == answer.upper():
                    correct += 1
                    e.config(bg="#14532d")
                else:
                    e.config(bg="#7f1d1d")

        return correct, possible

    # ========================================================
    # Hints
    # ========================================================

    def hint(self):

        if not self.question:
            return

        if self.mode.get() == "VLSM":

            messagebox.showinfo(
                "VLSM Hint",
                "Remember:\n\n"
                "1. Sort hosts largest → smallest.\n"
                "2. Add 2 for network/broadcast.\n"
                "3. Round up to the next power of 2.\n"
                "4. Allocate the largest block first."
            )

        elif self.mode.get() == "Binary":

            messagebox.showinfo(
                "Binary Hint",
                "An IPv4 mask has 32 bits.\n\n"
                "Each 1 represents the network portion.\n"
                "Each 0 represents the host portion."
            )

        else:

            cidr = self.question["cidr"]

            messagebox.showinfo(
                "Subnetting Hint",
                f"CIDR is /{cidr}.\n\n"
                f"Host bits = {32 - cidr}.\n\n"
                "Usable hosts = 2^host_bits - 2 "
                "for normal /1–/30 networks."
            )

    # ========================================================
    # Solutions
    # ========================================================

    def solution(self):

        if not self.question:
            return

        if self.mode.get() == "VLSM":

            text = (
                f"BASE NETWORK\n"
                f"{self.question['base']}\n\n"
                f"Allocate largest → smallest.\n\n"
            )

            for i, (hosts, answer) in enumerate(
                zip(
                    self.question["hosts"],
                    self.question["answers"]
                ),
                1
            ):

                text += (
                    f"SUBNET {i} — {hosts} HOSTS\n"
                    f"CIDR:       {answer[0]}\n"
                    f"Mask:       {answer[1]}\n"
                    f"Network:    {answer[2]}\n"
                    f"First:      {answer[3]}\n"
                    f"Last:       {answer[4]}\n"
                    f"Broadcast:  {answer[5]}\n\n"
                )

        else:

            labels = (
                ["Answer"] if self.mode.get() == "Binary"
                else [
                    "Subnet mask",
                    "Wildcard mask",
                    "Class",
                    "Network",
                    "First usable",
                    "Last usable",
                    "Broadcast",
                    "Usable hosts",
                    "Subnets",
                    "Larger CIDR",
                    "Smaller subnets"
                ]
            )

            text = "\n".join(
                f"{label}: {answer}"
                for label, answer in zip(
                    labels,
                    self.question["answers"]
                )
            )

        win = tk.Toplevel(self.root)
        win.title("Solution")
        win.geometry("650x650")
        win.configure(bg=self.BG)

        box = tk.Text(
            win,
            bg=self.PANEL,
            fg=self.WHITE,
            font=("Courier New", 10),
            padx=20,
            pady=20,
            relief="flat"
        )

        box.pack(
            fill="both",
            expand=True,
            padx=15,
            pady=15
        )

        box.insert("1.0", text)
        box.config(state="disabled")

    # ========================================================
    # Timer
    # ========================================================

    def start_timer(self):

        if self.timer_id:
            self.root.after_cancel(
                self.timer_id
            )
            self.timer_id = None

        if not self.timer_var.get():
            self.timer_label.config(
                text="∞",
                fg=self.CYAN
            )
            return

        times = {
            "Easy": 120,
            "Medium": 90,
            "Hard": 60,
            "Expert": 45
        }

        self.time_left = times[
            self.difficulty.get()
        ]

        self.tick()

    def tick(self):

        if self.answered:
            return

        mins = self.time_left // 60
        secs = self.time_left % 60

        self.timer_label.config(
            text=f"{mins:02}:{secs:02}",
            fg=(
                self.RED
                if self.time_left <= 10
                else self.YELLOW
                if self.time_left <= 30
                else self.CYAN
            )
        )

        if self.time_left <= 0:

            self.status.config(
                text="Time's up!"
            )

            self.answered = True

            if self.mode.get() == "VLSM":
                self.possible += len(
                    self.question["answers"]
                ) * 6
            else:
                self.possible += len(
                    self.question["answers"]
                )

            self.streak = 0
            self.update_stats()

            return

        self.time_left -= 1

        self.timer_id = self.root.after(
            1000,
            self.tick
        )

    # ========================================================
    # Statistics
    # ========================================================

    def update_stats(self):

        accuracy = (
            self.score / self.possible * 100
            if self.possible else 0
        )

        self.question_stat.config(
            text=f"{self.question_no}/{self.question_count}"
        )

        self.score_stat.config(
            text=f"{self.score}/{self.possible}"
        )

        self.streak_stat.config(
            text=str(self.streak)
        )

        self.accuracy_stat.config(
            text=f"{accuracy:.0f}%"
        )

    # ========================================================
    # End / finish
    # ========================================================

    def end_quiz(self):

        if self.question_no == 0:
            self.root.destroy()
            return

        self.finish_quiz()

    def finish_quiz(self):

        if self.timer_id:
            self.root.after_cancel(
                self.timer_id
            )
            self.timer_id = None

        accuracy = (
            self.score / self.possible * 100
            if self.possible else 0
        )

        messagebox.showinfo(
            "Quiz Complete",
            "CCNA SUBNETTING PRACTICE\n\n"
            f"Questions: {self.question_no}\n"
            f"Score: {self.score}/{self.possible}\n"
            f"Accuracy: {accuracy:.1f}%\n"
            f"Best streak: {self.best_streak}"
        )

        self.question_no = 0
        self.score = 0
        self.possible = 0
        self.streak = 0

        self.update_stats()
        self.new_question()


