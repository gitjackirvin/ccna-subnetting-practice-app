import tkinter as tk
from tkinter import messagebox
import random
import ipaddress


class App:
    BG = "#0f172a"
    PANEL = "#1e293b"
    INPUT = "#263449"
    WHITE = "#f8fafc"
    MUTED = "#94a3b8"
    BLUE = "#3b82f6"
    GREEN = "#22c55e"
    RED = "#ef4444"
    YELLOW = "#f59e0b"
    CYAN = "#06b6d4"

    def __init__(self, root):
        self.root = root
        root.title("CCNA Subnetting Practice")
        root.geometry("1050x750")
        root.minsize(700, 550)
        root.configure(bg=self.BG)

        self.mode = tk.StringVar(value="Subnetting")
        self.diff = tk.StringVar(value="Medium")
        self.questions = tk.StringVar(value="10")

        self.q = None
        self.qnum = 0
        self.score = 0
        self.possible = 0
        self.streak = 0
        self.best = 0
        self.inputs = []
        self.vlsm_inputs = []
        self.answered = False

        self.build()
        self.new_question()

    # ========================================================
    # BASIC WIDGETS
    # ========================================================

    def text(self, parent, value, size=10, color=None, bold=False):
        return tk.Label(
            parent,
            text=value,
            font=("Arial", size, "bold" if bold else "normal"),
            fg=color or self.WHITE,
            bg=parent["bg"]
        )

    def button(self, parent, text, command, color):
        return tk.Button(
            parent,
            text=text,
            command=command,
            bg=color,
            fg="white",
            activebackground=color,
            activeforeground="white",
            relief="flat",
            font=("Arial", 10, "bold"),
            padx=14,
            pady=7
        )

    # ========================================================
    # UI
    # ========================================================

    def build(self):
        header = tk.Frame(self.root, bg=self.BG)
        header.pack(fill="x", padx=20, pady=12)

        self.text(
            header,
            "CCNA SUBNETTING PRACTICE",
            24,
            bold=True
        ).pack(side="left")

        self.timer_label = self.text(
            header,
            "∞",
            18,
            self.CYAN,
            True
        )
        self.timer_label.pack(side="right")

        # Settings
        settings = tk.Frame(
            self.root,
            bg=self.PANEL,
            padx=8,
            pady=8
        )
        settings.pack(fill="x", padx=20, pady=5)

        self.menu(
            settings,
            "Mode",
            self.mode,
            ["Subnetting", "VLSM", "Binary"],
            self.restart
        )

        self.menu(
            settings,
            "Difficulty",
            self.diff,
            ["Easy", "Medium", "Hard", "Expert"],
            self.new_question
        )

        self.menu(
            settings,
            "Questions",
            self.questions,
            ["5", "10", "20", "30", "50"],
            self.restart
        )

        # Stats
        stats = tk.Frame(self.root, bg=self.BG)
        stats.pack(fill="x", padx=20, pady=5)

        self.qstat = self.stat(stats, "QUESTION")
        self.sstat = self.stat(stats, "SCORE")
        self.ststat = self.stat(stats, "STREAK")
        self.astat = self.stat(stats, "ACCURACY")

        # Question panel
        panel = tk.Frame(
            self.root,
            bg=self.PANEL,
            padx=15,
            pady=12
        )
        panel.pack(fill="x", padx=20, pady=6)

        self.type_label = self.text(
            panel,
            "",
            10,
            self.MUTED,
            True
        )
        self.type_label.pack()

        self.question_label = self.text(
            panel,
            "",
            22,
            self.CYAN,
            True
        )
        self.question_label.pack(pady=4)

        self.instruction = self.text(
            panel,
            "",
            10,
            self.MUTED
        )
        self.instruction.pack()

        # Answer area
        self.answer_area = tk.Frame(
            self.root,
            bg=self.BG
        )
        self.answer_area.pack(
            fill="both",
            expand=True,
            padx=20,
            pady=5
        )

        # Buttons
        buttons = tk.Frame(
            self.root,
            bg=self.BG
        )
        buttons.pack(pady=8)

        for name, command, color in [
            ("SUBMIT", self.check, self.BLUE),
            ("HINT", self.hint, self.YELLOW),
            ("SOLUTION", self.solution, "#334155"),
            ("NEXT", self.new_question, self.GREEN),
            ("END", self.end, self.RED)
        ]:
            self.button(
                buttons,
                name,
                command,
                color
            ).pack(side="left", padx=3)

        self.status = self.text(
            self.root,
            "",
            10,
            self.MUTED
        )
        self.status.pack(pady=3)

        # Resize handler
        self.root.bind(
            "<Configure>",
            self.resize
        )

    def menu(self, parent, name, variable, values, command):
        self.text(
            parent,
            name,
            9,
            bold=True
        ).pack(side="left", padx=(8, 3))

        m = tk.OptionMenu(
            parent,
            variable,
            *values,
            command=lambda _: command()
        )

        m.config(
            bg="#334155",
            fg=self.WHITE,
            activebackground=self.BLUE,
            activeforeground="white",
            highlightthickness=0
        )

        m["menu"].config(
            bg="#334155",
            fg=self.WHITE
        )

        m.pack(side="left", padx=4)

    def stat(self, parent, name):
        f = tk.Frame(
            parent,
            bg=self.PANEL,
            padx=10,
            pady=4
        )

        f.pack(
            side="left",
            fill="x",
            expand=True,
            padx=2
        )

        self.text(
            f,
            name,
            8,
            self.MUTED,
            True
        ).pack()

        value = self.text(
            f,
            "0",
            13,
            bold=True
        )
        value.pack()

        return value

    # ========================================================
    # RESPONSIVE SIZING
    # ========================================================

    def resize(self, event):
        if event.widget != self.root:
            return

        width = self.root.winfo_width()

        # Scale question text
        if width < 800:
            self.question_label.config(
                font=("Courier New", 18, "bold")
            )
        elif width < 950:
            self.question_label.config(
                font=("Courier New", 21, "bold")
            )
        else:
            self.question_label.config(
                font=("Courier New", 24, "bold")
            )

    # ========================================================
    # QUESTION CONTROL
    # ========================================================

    def clear(self):
        self.inputs = []
        self.vlsm_inputs = []
        self.answered = False

        for widget in self.answer_area.winfo_children():
            widget.destroy()

    def restart(self):
        self.qnum = 0
        self.score = 0
        self.possible = 0
        self.streak = 0
        self.best = 0
        self.new_question()

    def new_question(self):
        self.clear()

        count = int(self.questions.get())

        if self.qnum >= count:
            self.finish()
            return

        self.qnum += 1

        if self.mode.get() == "Subnetting":
            self.make_subnet()
        elif self.mode.get() == "VLSM":
            self.make_vlsm()
        else:
            self.make_binary()

        self.update_stats()

    # ========================================================
    # SUBNETTING
    # ========================================================

    def make_subnet(self):
        minimum = {
            "Easy": 24,
            "Medium": 16,
            "Hard": 8,
            "Expert": 1
        }[self.diff.get()]

        cidr = random.randint(minimum, 30)

        ip = ipaddress.IPv4Address(
            random.randint(1, 0xFFFFFFFE)
        )

        network = ipaddress.ip_network(
            f"{ip}/{cidr}",
            strict=False
        )

        first = int(str(ip).split(".")[0])

        if first <= 126:
            address_class = "A"
            default = 8
        elif first <= 191:
            address_class = "B"
            default = 16
        elif first <= 223:
            address_class = "C"
            default = 24
        elif first <= 239:
            address_class = "D"
            default = None
        else:
            address_class = "E"
            default = None

        subnets = (
            2 ** (cidr - default)
            if default and cidr >= default
            else "N/A"
        )

        bigger = (
            random.randint(cidr + 1, 30)
            if cidr < 30
            else 31
        )

        self.q = {
            "cidr": cidr,
            "answers": [
                str(network.netmask),
                str(network.hostmask),
                address_class,
                str(network.network_address),
                str(network.network_address + 1),
                str(network.broadcast_address - 1),
                str(network.broadcast_address),
                str(network.num_addresses - 2),
                str(subnets),
                f"/{bigger}",
                str(2 ** (bigger - cidr))
            ]
        }

        self.type_label.config(
            text="STANDARD IPv4 SUBNETTING"
        )

        self.question_label.config(
            text=f"{ip} /{cidr}"
        )

        self.instruction.config(
            text="Calculate every field."
        )

        self.add_fields([
            "Subnet mask",
            "Wildcard mask",
            "Address class",
            "Network address",
            "First usable IP",
            "Last usable IP",
            "Broadcast address",
            "Usable hosts",
            "Number of subnets",
            "Larger CIDR",
            "Subnets that fit"
        ])

    # ========================================================
    # VLSM
    # ========================================================

    def make_vlsm(self):
        settings = {
            "Easy": (
                24, 3,
                [4, 6, 10, 12, 20, 25]
            ),
            "Medium": (
                23, 4,
                [6, 10, 12, 20, 25, 30, 50]
            ),
            "Hard": (
                22, 5,
                [10, 12, 20, 25, 30, 50, 60, 100]
            ),
            "Expert": (
                20, 6,
                [20, 25, 30, 50, 60, 100, 120, 200]
            )
        }

        prefix, count, choices = settings[
            self.diff.get()
        ]

        while True:
            hosts = sorted(
                random.sample(choices, count),
                reverse=True
            )

            blocks = [
                2 ** ((h + 2 - 1).bit_length())
                for h in hosts
            ]

            if sum(blocks) <= 2 ** (32 - prefix):
                break

        base = ipaddress.ip_network(
            f"{random.randint(1, 223)}.0.0.0/{prefix}",
            strict=False
        )

        current = int(base.network_address)
        answers = []

        for block in blocks:
            new_prefix = 32 - (
                block.bit_length() - 1
            )

            network = ipaddress.ip_network(
                (current, new_prefix)
            )

            answers.append([
                f"/{new_prefix}",
                str(network.netmask),
                str(network.network_address),
                str(network.network_address + 1),
                str(network.broadcast_address - 1),
                str(network.broadcast_address)
            ])

            current += block

        self.q = {
            "base": str(base),
            "hosts": hosts,
            "answers": answers
        }

        self.type_label.config(
            text="VLSM"
        )

        self.question_label.config(
            text=str(base)
        )

        self.instruction.config(
            text=f"Allocate subnets for: {hosts}"
        )

        self.make_vlsm_table()

    def make_vlsm_table(self):
        # Canvas gives us scrolling if the window is too narrow.
        outer = tk.Frame(
            self.answer_area,
            bg=self.BG
        )
        outer.pack(
            fill="both",
            expand=True
        )

        canvas = tk.Canvas(
            outer,
            bg=self.BG,
            highlightthickness=0
        )
        canvas.pack(
            side="left",
            fill="both",
            expand=True
        )

        scrollbar = tk.Scrollbar(
            outer,
            orient="horizontal",
            command=canvas.xview
        )
        scrollbar.pack(
            side="bottom",
            fill="x"
        )

        canvas.configure(
            xscrollcommand=scrollbar.set
        )

        table = tk.Frame(
            canvas,
            bg=self.BG
        )

        window = canvas.create_window(
            (0, 0),
            window=table,
            anchor="nw"
        )

        def update_scroll(_=None):
            canvas.configure(
                scrollregion=canvas.bbox("all")
            )

            # Let the table fill the screen when possible.
            if canvas.winfo_width() > table.winfo_reqwidth():
                canvas.itemconfig(
                    window,
                    width=canvas.winfo_width()
                )

        table.bind(
            "<Configure>",
            update_scroll
        )

        canvas.bind(
            "<Configure>",
            update_scroll
        )

        headers = [
            "#", "Hosts", "CIDR", "Mask",
            "Network", "First", "Last", "Broadcast"
        ]

        # Responsive column sizes
        widths = [
            4, 7, 9, 15,
            15, 15, 15, 15
        ]

        for col, header in enumerate(headers):
            self.text(
                table,
                header,
                8,
                self.CYAN,
                True
            ).grid(
                row=0,
                column=col,
                padx=1,
                pady=3,
                sticky="ew"
            )

            table.columnconfigure(
                col,
                weight=1
            )

        for row, (hosts, answers) in enumerate(
            zip(
                self.q["hosts"],
                self.q["answers"]
            ),
            1
        ):
            self.text(
                table,
                str(row),
                8
            ).grid(
                row=row,
                column=0,
                sticky="ew"
            )

            self.text(
                table,
                str(hosts),
                8,
                self.YELLOW
            ).grid(
                row=row,
                column=1,
                sticky="ew"
            )

            entries = []

            for col, answer in enumerate(
                answers,
                2
            ):
                entry = tk.Entry(
                    table,
                    width=widths[col],
                    bg=self.INPUT,
                    fg=self.WHITE,
                    insertbackground=self.WHITE,
                    relief="flat",
                    font=("Arial", 8)
                )

                entry.grid(
                    row=row,
                    column=col,
                    padx=1,
                    pady=2,
                    ipady=3,
                    sticky="ew"
                )

                entries.append(entry)

            self.vlsm_inputs.append(entries)

    # ========================================================
    # BINARY
    # ========================================================

    def make_binary(self):
        cidr = random.randint(1, 30)

        mask = ipaddress.IPv4Network(
            f"0.0.0.0/{cidr}"
        ).netmask

        binary = ".".join(
            f"{int(x):08b}"
            for x in str(mask).split(".")
        )

        choice = random.randint(0, 2)

        if choice == 0:
            question = str(mask)
            answer = binary
            instruction = "Convert the mask to binary."

        elif choice == 1:
            question = f"/{cidr}"
            answer = str(mask)
            instruction = "Convert CIDR to a subnet mask."

        else:
            question = binary
            answer = str(mask)
            instruction = "Convert binary to a subnet mask."

        self.q = {
            "answers": [answer]
        }

        self.type_label.config(
            text="BINARY PRACTICE"
        )

        self.question_label.config(
            text=question
        )

        self.instruction.config(
            text=instruction
        )

        self.add_fields(["Answer"])

    # ========================================================
    # INPUT FIELDS
    # ========================================================

    def add_fields(self, labels):
        for label in labels:
            row = tk.Frame(
                self.answer_area,
                bg=self.BG
            )

            row.pack(
                fill="x",
                pady=2
            )

            self.text(
                row,
                label,
                9
            ).pack(
                side="left",
                padx=5
            )

            entry = tk.Entry(
                row,
                width=30,
                bg=self.INPUT,
                fg=self.WHITE,
                insertbackground=self.WHITE,
                relief="flat"
            )

            entry.pack(
                side="left",
                fill="x",
                expand=True,
                padx=(0, 10),
                ipady=3
            )

            self.inputs.append(entry)

    # ========================================================
    # CHECK
    # ========================================================

    def check(self):
        if self.answered:
            return

        self.answered = True

        if self.mode.get() == "VLSM":
            correct = 0
            possible = len(
                self.q["answers"]
            ) * 6

            for row, answers in zip(
                self.vlsm_inputs,
                self.q["answers"]
            ):
                for entry, answer in zip(
                    row,
                    answers
                ):
                    ok = (
                        entry.get().strip().upper()
                        == answer.upper()
                    )

                    entry.config(
                        bg="#14532d"
                        if ok else "#7f1d1d"
                    )

                    correct += ok

        else:
            correct = 0
            possible = len(self.inputs)

            for entry, answer in zip(
                self.inputs,
                self.q["answers"]
            ):
                ok = (
                    entry.get().strip().upper()
                    == answer.upper()
                )

                entry.config(
                    bg="#14532d"
                    if ok else "#7f1d1d"
                )

                correct += ok

        self.score += correct
        self.possible += possible

        if correct == possible:
            self.streak += 1
            self.best = max(
                self.best,
                self.streak
            )
        else:
            self.streak = 0

        self.update_stats()

        self.status.config(
            text=f"{correct}/{possible} correct"
        )

    # ========================================================
    # HINT
    # ========================================================

    def hint(self):
        if self.mode.get() == "VLSM":
            message = (
                "VLSM method:\n\n"
                "1. Sort requirements largest → smallest.\n"
                "2. Add 2 for network/broadcast.\n"
                "3. Round up to the next power of 2.\n"
                "4. Allocate the largest block first."
            )

        elif self.mode.get() == "Binary":
            message = (
                "A /N mask has N network bits "
                "followed by host bits."
            )

        else:
            message = (
                f"/{self.q['cidr']} leaves "
                f"{32 - self.q['cidr']} host bits.\n\n"
                "Usable hosts = 2^host bits - 2."
            )

        messagebox.showinfo(
            "Hint",
            message
        )

    # ========================================================
    # SOLUTION
    # ========================================================

    def solution(self):
        if self.mode.get() == "VLSM":
            output = (
                f"BASE NETWORK: {self.q['base']}\n\n"
            )

            for i, (hosts, answers) in enumerate(
                zip(
                    self.q["hosts"],
                    self.q["answers"]
                ),
                1
            ):
                output += (
                    f"SUBNET {i} — {hosts} HOSTS\n"
                    f"CIDR:      {answers[0]}\n"
                    f"Mask:      {answers[1]}\n"
                    f"Network:   {answers[2]}\n"
                    f"First:     {answers[3]}\n"
                    f"Last:      {answers[4]}\n"
                    f"Broadcast: {answers[5]}\n\n"
                )

        elif self.mode.get() == "Subnetting":
            labels = [
                "Subnet mask",
                "Wildcard mask",
                "Class",
                "Network",
                "First usable",
                "Last usable",
                "Broadcast",
                "Usable hosts",
                "Subnets",
                "Larger CIDR",
                "Subnets that fit"
            ]

            output = "\n".join(
                f"{a}: {b}"
                for a, b in zip(
                    labels,
                    self.q["answers"]
                )
            )

        else:
            output = (
                f"Answer: {self.q['answers'][0]}"
            )

        win = tk.Toplevel(self.root)
        win.title("Solution")
        win.geometry("600x600")
        win.configure(bg=self.BG)

        box = tk.Text(
            win,
            bg=self.PANEL,
            fg=self.WHITE,
            font=("Courier New", 10),
            wrap="none"
        )

        box.pack(
            fill="both",
            expand=True,
            padx=10,
            pady=10
        )

        box.insert(
            "1.0",
            output
        )

        box.config(
            state="disabled"
        )

    # ========================================================
    # STATS
    # ========================================================

    def update_stats(self):
        accuracy = (
            self.score / self.possible * 100
            if self.possible
            else 0
        )

        self.qstat.config(
            text=f"{self.qnum}/{self.questions.get()}"
        )

        self.sstat.config(
            text=f"{self.score}/{self.possible}"
        )

        self.ststat.config(
            text=str(self.streak)
        )

        self.astat.config(
            text=f"{accuracy:.0f}%"
        )

    # ========================================================
    # FINISH
    # ========================================================

    def end(self):
        self.finish()

    def finish(self):
        if not self.qnum:
            return

        accuracy = (
            self.score / self.possible * 100
            if self.possible
            else 0
        )

        messagebox.showinfo(
            "Quiz Complete",
            f"Questions: {self.qnum}\n"
            f"Score: {self.score}/{self.possible}\n"
            f"Accuracy: {accuracy:.1f}%\n"
            f"Best streak: {self.best}"
        )

        self.qnum = 0
        self.score = 0
        self.possible = 0
        self.streak = 0

        self.new_question()


if __name__ == "__main__":
    root = tk.Tk()
    App(root)
    root.mainloop()
