    def menu(self, parent, label, variable, values, command):

        tk.Label(
            parent,
            text=label,
            fg=self.WHITE,
            bg=self.PANEL,
            font=("Arial", 10, "bold")
        ).pack(side="left", padx=(8, 4))

        m = tk.OptionMenu(
            parent, variable, *values,
            command=lambda _: command()
        )

        m.config(
            bg=self.PANEL2,
            fg=self.WHITE,
            activebackground=self.BLUE,
            activeforeground=self.WHITE,
            highlightthickness=0
